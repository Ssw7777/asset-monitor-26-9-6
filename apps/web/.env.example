# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------
DASHBOARD_PASSWORD=change-me-to-a-strong-password
SESSION_SECRET=replace-with-a-long-random-string-at-least-32-chars

# Optional FX rate (also editable in UI)
USD_CNY_RATE=6.66

# ---------------------------------------------------------------------------
# Persistence
# ---------------------------------------------------------------------------
# Local development always uses data/store.json (ignored by git).
# For Vercel/serverless, prefer Turso/libSQL:
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Without Turso, serverless uses memory + /tmp/store.json (ephemeral).

# AES-256-GCM key for encrypting CEX credentials saved in the database.
# 64 hex chars (32 bytes) or any strong passphrase; never commit it.
ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Exchange APIs (read-only only; never enable trade/withdraw)
# ---------------------------------------------------------------------------
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=
OKX_SIMULATED=0

BINANCE_API_KEY=
BINANCE_API_SECRET=

GATE_API_KEY=
GATE_API_SECRET=

# Optional extra Gate accounts. Set both values for an account or neither.
GATE_B_KEY=
GATE_B_SECRET=
GATE_C_KEY=
GATE_C_SECRET=

BITGET_API_KEY=
BITGET_API_SECRET=
BITGET_API_PASSPHRASE=

# ---------------------------------------------------------------------------
# On-chain / DeFi providers (all optional; use your own keys)
# ---------------------------------------------------------------------------
ALCHEMY_API_KEY=
ZERION_API_KEY=
# Optional multiple Zerion keys, comma-separated:
ZERION_API_KEYS=
COINSTATS_API_KEY=
DEBANK_ACCESS_KEY=

# Binance Web3 Developer Portal (read-only data; not the exchange API)
BN_WEB3_API_KEY=
BN_WEB3_API_SECRET=
# Optional keep-list: comma separated chain:symbol or chain:0xcontract
BN_WALLET_TOKEN_ALLOWLIST=

# OKX Web3 read-only data (not the exchange API)
OKX_WEB3_API_KEY=
OKX_WEB3_API_SECRET=
OKX_WEB3_PASSPHRASE=

# OKX OnchainOS (optional)
OKX_ONCHAINOS_API_KEY=
OKX_ONCHAINOS_API_SECRET=
OKX_ONCHAINOS_API_PASSPHRASE=

# Sanitize upstream snapshots before storing (recommended)
SANITIZE_ON_READ=1

# ---------------------------------------------------------------------------
# Scheduled refresh
# ---------------------------------------------------------------------------
# Send: Authorization: Bearer $CRON_SECRET
CRON_SECRET=

# Optional base path when mounted under a subpath (for example /asset)
NEXT_PUBLIC_STUDY_BASE_PATH=

# Local HTTP-only development over plain http only. Do not use in production.
FORCE_INSECURE_COOKIES=0
